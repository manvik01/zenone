# Copy to .env in this directory:
#   cp .env.example .env
#
# Existing process.env values are not overwritten. JWT_SECRET is required in
# production (NODE_ENV=production): non-default, at least 32 characters.

# Server
PORT=3000
NODE_ENV=development

# HMAC secret for access + refresh JWTs.
# Development: optional (falls back to a well-known default and logs a warning).
# Production: required, must not be the default, min 32 characters.
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# CORS. Prototype default is allow-all (*).
# Restrict with a comma-separated origin list, e.g. http://localhost:3001
CORS_ORIGIN=*

# Rate limiting is not implemented in this prototype.
# See ../../docs/PRODUCTION.md for prototype shortcuts (in-memory, no TLS).
